import cv2
import pytesseract

# If Tesseract is not automatically detected,
# uncomment and change this path:
# pytesseract.pytesseract.tesseract_cmd = r"C:\Program Files\Tesseract-OCR\tesseract.exe"

# Read the vehicle image
image = cv2.imread("car.jpg")

if image is None:
    print("Error: car.jpg not found!")
    exit()

# Convert to grayscale
gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)

# Reduce noise
gray = cv2.bilateralFilter(gray, 11, 17, 17)

# Detect edges
edges = cv2.Canny(gray, 30, 200)

# Find contours
contours, _ = cv2.findContours(
    edges,
    cv2.RETR_TREE,
    cv2.CHAIN_APPROX_SIMPLE
)

contours = sorted(contours, key=cv2.contourArea, reverse=True)

plate = None

# Search for a rectangular plate
for contour in contours:
    perimeter = cv2.arcLength(contour, True)
    approx = cv2.approxPolyDP(contour, 0.018 * perimeter, True)

    if len(approx) == 4:
        x, y, w, h = cv2.boundingRect(approx)

        if w > 100 and h > 20 and w / h > 2:
            plate = gray[y:y+h, x:x+w]

            # Draw rectangle around detected plate
            cv2.rectangle(
                image,
                (x, y),
                (x+w, y+h),
                (0, 255, 0),
                3
            )
            break

if plate is not None:

    # Improve plate image
    _, plate = cv2.threshold(
        plate, 0, 255,
        cv2.THRESH_BINARY + cv2.THRESH_OTSU
    )

    # OCR
    text = pytesseract.image_to_string(
        plate,
        config="--psm 7"
    )

    text = text.strip()

    print("License Plate Number:", text)

    cv2.imshow("Detected License Plate", plate)
    cv2.imshow("Vehicle", image)

else:
    print("License plate not detected.")

cv2.waitKey(0)
cv2.destroyAllWindows()